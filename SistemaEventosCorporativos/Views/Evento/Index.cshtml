@model IEnumerable<SistemaEventosCorporativos.Models.Evento>

@{
    ViewData["Title"] = "Eventos";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a href="@Url.Action("Create")" class="btn btn-primary">Criar Novo Evento</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Data</th>
            <th>Local</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var evento in Model)
        {
            <tr>
                <td>@evento.Nome</td>
                <td>@evento.Data.ToString("dd/MM/yyyy")</td>
                <td>@evento.Local</td>
                <td>
                    <a href="@Url.Action("Edit", new { id = evento.Id })" class="btn btn-warning">Editar</a>
                    <a href="@Url.Action("Delete", new { id = evento.Id })" class="btn btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>