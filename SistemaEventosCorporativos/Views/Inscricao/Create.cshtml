@model SistemaEventosCorporativos.Models.Inscricao

@{
    ViewData["Title"] = "Cadastrar Inscrição";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label for="ParticipanteId">Participante</label>
        <select asp-for="ParticipanteId" class="form-control" asp-items="ViewBag.ParticipanteId"></select>
    </div>
    <div class="form-group">
        <label for="EventoId">Evento</label>
        <select asp-for="EventoId" class="form-control" asp-items="ViewBag.EventoId"></select>
    </div>
    <div class="form-group">
        <label for="DataInscricao">Data da Inscrição</label>
        <input asp-for="DataInscricao" class="form-control" type="date" />
    </div>
    <div class="form-group">
        <button type="submit" class="btn btn-primary">Cadastrar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>