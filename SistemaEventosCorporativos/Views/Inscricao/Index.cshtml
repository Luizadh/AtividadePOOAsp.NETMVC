@model IEnumerable<SistemaEventosCorporativos.Models.Inscricao>

@{
    ViewData["Title"] = "Lista de Inscrições";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Cadastrar Nova Inscrição</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Participante</th>
            <th>Evento</th>
            <th>Data de Inscrição</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var inscricao in Model)
        {
            <tr>
                <td>@inscricao.Id</td>
                <td>@inscricao.Participante.Nome</td>
                <td>@inscricao.Evento.Nome</td>
                <td>@inscricao.DataInscricao.ToString("dd/MM/yyyy")</td>
                <td>
                    <a asp-action="Delete" asp-route-id="@inscricao.Id" class="btn btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>