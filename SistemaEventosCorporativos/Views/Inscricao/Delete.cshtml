@model SistemaEventosCorporativos.Models.Inscricao

@{
    ViewData["Title"] = "Excluir Inscrição";
}

<h1>@ViewData["Title"]</h1>

<h3>Tem certeza que deseja excluir a inscrição de <strong>@Model.Participante.Nome</strong> para o evento <strong>@Model.Evento.Nome</strong>?</h3>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <button type="submit" class="btn btn-danger">Excluir</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>