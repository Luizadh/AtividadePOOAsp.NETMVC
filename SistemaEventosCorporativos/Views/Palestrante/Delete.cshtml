@model SistemaEventosCorporativos.Models.Palestrante

@{
    ViewData["Title"] = "Excluir Palestrante";
}

<h1>Excluir Palestrante</h1>

<h3>Tem certeza que deseja excluir este palestrante?</h3>

<div>
    <h4>Palestrante</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nome</dt>
        <dd class="col-sm-10">@Model.Nome</dd>

        <dt class="col-sm-2">Currículo</dt>
        <dd class="col-sm-10">@Model.Curriculo</dd>

        <dt class="col-sm-2">Evento</dt>
        <dd class="col-sm-10">@Model.Evento?.Nome</dd>
    </dl>
</div>

<form asp-action="DeleteConfirmed">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Excluir</button> |
    <a asp-action="Index">Voltar</a>
</form>