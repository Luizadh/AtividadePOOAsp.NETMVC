@model SistemaEventosCorporativos.Models.Palestrante

@{
    ViewData["Title"] = "Novo Palestrante";
}

<h1>Novo Palestrante</h1>

<form asp-action="Create">
    <div class="form-group">
        <label asp-for="Nome" class="control-label"></label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Curriculo" class="control-label"></label>
        <input asp-for="Curriculo" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="EventoId" class="control-label">Evento</label>
        <select asp-for="EventoId" class="form-control" asp-items="ViewBag.EventoId"></select>
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
</form>
<a asp-action="Index">Voltar</a>
